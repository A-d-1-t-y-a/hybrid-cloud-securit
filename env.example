# Hybrid Cloud Security Framework - Environment Variables
# Copy this file to .env and update the values

# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///./security_framework.db

# Security Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption Configuration
ENCRYPTION_KEY=your-encryption-key-here-change-this-in-production

# AWS Configuration (Optional - for cloud integration)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# Compliance Configuration
COMPLIANCE_STANDARDS=GDPR,HIPAA,SOX,ISO27001,PCI_DSS
POLICY_ENFORCEMENT=true

# SOAR Configuration
SOAR_ENABLED=true
THREAT_INTELLIGENCE_ENABLED=true
AUTOMATION_ENABLED=true
WORKFLOW_ENGINE_ENABLED=true